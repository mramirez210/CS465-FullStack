<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Rooms - Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header activeRooms=true}}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>{{title}}</h1>
							<ul id="rooms">
								{{#each rooms}}
								<li>
									<a href="/rooms"><img src="{{image}}" alt="{{name}}"></a>
									<h2><a href="/rooms">{{name}}</a></h2>
									<p>{{description}}</p>
									<span class="rate">{{rate}}</span>
								</li>
								{{/each}}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer activeRooms=true}}
	</div>
</body>
</html>