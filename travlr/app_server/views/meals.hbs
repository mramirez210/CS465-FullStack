<!DOCTYPE html>
<!-- Website template by freewebsitetemplates.com -->
<html>
<head>
	<meta charset="UTF-8">
	<title>Foods - Travlr Getaways Website Template</title>
	<link rel="stylesheet" href="/css/style.css" type="text/css">
</head>
<body>
	<div id="background">
		<div id="page">
			{{> header activeMeals=true}}
			<div id="contents">
				<div class="box">
					<div>
						<div class="body">
							<h1>{{title}}</h1>
							<ul id="foods">
								{{#each meals}}
								<li>
									<h2><a href="/meals">{{name}}</a></h2>
									<div class="infos">
										<a href="/meals"><img src="{{image}}" alt="{{name}}" height="169" width="780"><span class="cover"></span></a>
										<p>
											<span>{{headline}}</span> {{description}}
										</p>
									</div>
								</li>
								{{/each}}
							</ul>
						</div>
					</div>
				</div>
			</div>
		</div>
		{{> footer activeMeals=true}}
	</div>
</body>
</html>